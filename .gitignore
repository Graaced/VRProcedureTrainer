# Unity project .gitignore
# Place this file in the root of the Unity project (the folder that contains Assets/ and ProjectSettings/).

# Folders Unity regenerates on its own
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/.utmp/

# Builds: publish them as GitHub Releases, not in the repository
/[Bb]uild/
/[Bb]uilds/

# Unity Recorder output (videos go to the portfolio, not to Git)
/[Rr]ecordings/

# Never ignore Asset meta data
!/[Aa]ssets/**/*.meta

# Uncomment if you use Gradle or exported Android projects
# .gradle/

# Autogenerated by IDEs (regenerated by Unity on open)
.vs/
.vscode/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity3D generated meta files for debug symbols
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and system info
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Build artifacts and packages
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
ExportedObj/

# Addressables and streaming assets caches
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Blender backup files
*.blend1
*.blend2

# OS files
.DS_Store
Thumbs.db
Desktop.ini
